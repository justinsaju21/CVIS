# CVIS Backend — environment variables
# Copy to .env and fill in values.
# .env is listed in .gitignore and MUST NOT be committed.

# ─── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────
# Path to SQLite file, relative to backend/ directory
DATABASE_URL=cvis.db
