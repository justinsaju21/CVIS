// ================================================================
// CVIS — firmware/secrets.h.example
// Copy this file to secrets.h and fill in your actual values.
// secrets.h is listed in .gitignore and MUST NOT be committed.
//
// Phase 2: api_key and device_secret come from:
//   POST http://<BACKEND_HOST>:8000/api/v1/devices/register
//   Body: {"device_id": "ESP32-001"}
// ================================================================

#pragma once

// ─── WiFi credentials ────────────────────────────────────────
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// ─── Backend connection ───────────────────────────────────────
#define BACKEND_HOST    "192.168.x.x"
#define BACKEND_PORT    "8000"

// ─── Device identity ──────────────────────────────────────────
#define DEVICE_ID       "ESP32-001"

// ─── Phase 2: Auth credentials (from /devices/register) ──────
// api_key: include in X-API-Key HTTP header (or MQTT _meta)
#define API_KEY         "PASTE_API_KEY_HERE_64_CHAR_HEX"

// device_secret: used for HMAC-SHA256 signing and AES-256-GCM encryption
// This is 64 hex chars (32 bytes). Keep it SECRET.
#define DEVICE_SECRET   "PASTE_DEVICE_SECRET_HERE_64_CHAR_HEX"
